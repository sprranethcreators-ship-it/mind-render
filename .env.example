# ==============================================================================
# MIND RENDER — Environment Variables & Gateway Configuration
# ==============================================================================

# Public Application URL
VITE_APP_URL=http://localhost:5173

# Razorpay Payment Gateway Configuration
# Note: When left unset or set to placeholder, MIND RENDER seamlessly activates
# the Verified Test Sandbox simulation for instant evaluations and test orders.
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Private Server Secret (For backend API order creation and webhook verification)
# NEVER expose this key in client-side code or public Git repositories!
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Cryptographic Token Salt for Secure PDF Licensing
PDF_LICENSE_SALT=mr_secure_secret_salt_2025

# CMS Storage Engine: 'local' (browser LocalStorage repository) or 'rest' / 'supabase'
VITE_STORAGE_BACKEND=local
